# ─────────────────────────────────────────────────────────────────────────────
# RAG Document Q&A — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy:  cp .env.example .env
# 2. Fill in real values below
# 3. NEVER commit .env to GitHub
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────────────────────
# GROQ_API_KEY is OPTIONAL — only needed if using Groq as the online/fallback
# provider. If Ollama is running locally, the system uses it automatically.
# Get your key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# ── Ollama (Local/Offline LLM) ───────────────────────────────────────────────
# Ollama server URL (default: http://localhost:11434)
# Change this if running Ollama on a different host or inside Docker.
OLLAMA_HOST=http://localhost:11434

# Model to use with Ollama. Pull it first:  ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT secret key — used to sign and verify tokens.
# MUST be a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If this key is leaked, anyone can forge auth tokens.
# If you change it, all existing sessions are immediately invalidated.
JWT_SECRET_KEY=replace_this_with_a_long_random_string_at_least_32_chars

# Token expiry in hours (default: 24 hours = 86400 seconds)
# ACCESS_TOKEN_EXPIRE_HOURS=24

# ── Optional tuning ───────────────────────────────────────────────────────────
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# RETRIEVAL_K=4
# BM25_WEIGHT=0.4
# FAISS_WEIGHT=0.6
# GROQ_MODEL=qwen/qwen3.6-27b
# LLM_TEMPERATURE=0.2

# ── Re-ranking (Phase 4) ─────────────────────────────────────────────────────
# RERANKING_ENABLED=true           # Set to false to disable CrossEncoder reranking
# RETRIEVAL_CANDIDATES=10          # How many docs to retrieve before reranking
# FINAL_CONTEXT_K=4                # How many docs to keep after reranking

# ── Query Rewriting (Phase 5) ────────────────────────────────────────────────
# QUERY_REWRITING_ENABLED=false    # Set to true to enable LLM query rewriting
                                   # Adds latency (one extra LLM call per request)
                                   # Can also be toggled per-request via use_query_rewriting field

# ── Multilingual Embeddings (Phase 11) ───────────────────────────────────────
# Default: English-optimized MiniLM-L6-v2
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# Multilingual (50+ languages, cross-lingual retrieval):
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#
# WARNING: Changing EMBEDDING_MODEL requires wiping and re-ingesting all uploaded
# document vector indices! Run `python rebuild_index.py --all` to reset indices.


